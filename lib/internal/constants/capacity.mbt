///|
/// 单 (版本, ecl, mode) 容量上限。mode_idx 0/1/2；ecl_idx 0/1/2/3；version_idx 0..=39。
/// 越界回退：mode>=3→0，ecl>=4→H(3)，version>=40→V40。
pub fn capacity_bytes(mode_idx : Int, ecl_idx : Int, version_idx : Int) -> Int {
  let m = if mode_idx < 0 || mode_idx > 2 { 0 } else { mode_idx }
  let e = if ecl_idx < 0 || ecl_idx > 3 { 3 } else { ecl_idx }
  let v = if version_idx < 0 || version_idx > 39 { 39 } else { version_idx }
  capacity_table[m][e][v]
}

///|
/// 给定 (mode, ecl) 与字符数 len，返回可容纳的最小版本序号（0..=39）；
/// len 超出 V40 容量时返回 -1（等价源码 Version::get 返回 None）。
pub fn version_for(mode_idx : Int, ecl_idx : Int, len : Int) -> Int {
  let m = if mode_idx < 0 || mode_idx > 2 { 0 } else { mode_idx }
  let e = if ecl_idx < 0 || ecl_idx > 3 { 3 } else { ecl_idx }
  if len < 0 {
    return -1
  }
  let mut v = 0
  while v < 40 {
    if capacity_table[m][e][v] >= len {
      return v
    }
    v += 1
  }
  -1
}

///|
/// 每版本数据总字节上限（不含纠错）。
pub fn max_bytes(version_idx : Int) -> Int {
  max_bytes_table[if version_idx < 0 || version_idx > 39 {
    39
  } else {
    version_idx
  }]
}

///|
/// 数据码字数 data_codewords(ecl_idx, version_idx)。
pub fn data_codewords(ecl_idx : Int, version_idx : Int) -> Int {
  let e = if ecl_idx < 0 || ecl_idx > 3 { 3 } else { ecl_idx }
  data_codewords_table[e][if version_idx < 0 || version_idx > 39 {
    39
  } else {
    version_idx
  }]
}

///|
/// 数据比特数 = data_codewords × 8（encode 容量判定 / 填终止符用）。
pub fn data_bits(ecl_idx : Int, version_idx : Int) -> Int {
  data_codewords(ecl_idx, version_idx) * 8
}

///|
/// 版本信息字（V7+ 非零；V1-V6 为 0）。供 S5 写版本信息区。
pub fn information(version_idx : Int) -> Int {
  information_table[if version_idx < 0 || version_idx > 39 {
    39
  } else {
    version_idx
  }]
}

///|
/// 对齐图案坐标（每版本一行，首坐标固定 6）。供 S4 放置对齐图案。
pub fn alignment_grid(version_idx : Int) -> Array[Int] {
  alignment_grid_table[if version_idx < 0 || version_idx > 39 {
    39
  } else {
    version_idx
  }].copy()
}

///|
/// 末端缺失填充比特数（0/3/4/7 四档）。
pub fn missing_bits(version_idx : Int) -> Int {
  missing_bits_table[if version_idx < 0 || version_idx > 39 {
    39
  } else {
    version_idx
  }]
}
