///|
/// s6_snapshot_test.mbt —— S6 全量端到端快照对齐（黑盒 _test.mbt）
/// 基准：fast_qr v0.14.0 经 snapshot_gen_s6 例程一次生成的参考全矩阵 hex（禁止手抄）。
/// 介质：公共 Module.byte() = 明暗|类型<<1，与参考同构；按格逐位比对 QRCode::build 输出。
/// 覆盖（S6 快照缺口收口）：
///   A. 三模式（Numeric/Alnum/Byte）× L/M/Q/H 在 V05 的矩阵级端到端逐位对齐；
///   B. V01 最短 / 版本信息区触发点 V14/V26/V32；
///   C. 全参数 None 纯自动路径（mode/ecl/version/mask 全自动）。
/// 复用同包 bstr/hexval/parse_hex（m1_snapshot_test.mbt 顶层，同包共享）。
fn c0() -> Array[Byte] {
  let r : Array[Byte] = []
  for
    ch in "012345678901234567890123456789012345678901234567890123456789012345678901234567890" {
    r.push(ch.to_int().to_byte())
  }
  r
}

///|
fn c1() -> Array[Byte] {
  let r : Array[Byte] = []
  for ch in "HELLO WORLD 1234567890 ABCDEFGHIJKLMNOP" {
    r.push(ch.to_int().to_byte())
  }
  r
}

///|
fn c2() -> Array[Byte] {
  let r : Array[Byte] = []
  for ch in "hi" {
    r.push(ch.to_int().to_byte())
  }
  r
}

///|
fn c3() -> Array[Byte] {
  let r : Array[Byte] = []
  for ch in "0123456789012345678901234" {
    r.push(ch.to_int().to_byte())
  }
  r
}

///|
fn c4() -> Array[Byte] {
  let r : Array[Byte] = []
  for ch in "https://example.com/path/to/page" {
    r.push(ch.to_int().to_byte())
  }
  r
}

///|
/// 经 QRCode::build 构建并把有效区 size*size 序列化为 Byte 数组。
fn c_v40h() -> Array[Byte] {
  Array::make(800, b'x')
}

///|
fn s6_raw(
  content : Array[Byte],
  modev : Mode?,
  eclv : ECL?,
  verv : Version?,
  maskv : Mask?,
) -> (Array[Byte], Version?, ECL?, Mask?, Mode?) {
  let qr = match QRCode::build(content, modev, eclv, verv, maskv) {
    Ok(q) => q
    Err(_) => abort("s6 build failed")
  }
  let n = qr.size()
  let out : Array[Byte] = []
  let mut i = 0
  while i < n * n {
    out.push(qr.get(i / n, i % n).byte())
    i += 1
  }
  (out, qr.version(), qr.ecl(), qr.mask(), qr.mode())
}

///|
/// 逐格比对 got(byte 数组) 与参考 hex；不一致给出首处 cell 差异。
fn s6_assert_matrix(
  got : Array[Byte],
  want : Array[Byte],
  tag : String,
) -> Unit raise {
  if got.length() != want.length() {
    fail(
      tag +
      ": length mismatch got " +
      got.length().to_string() +
      " want " +
      want.length().to_string(),
    )
  }
  let mut k = 0
  while k < got.length() {
    if got[k] != want[k] {
      fail(
        tag +
        " cell " +
        k.to_string() +
        ": got " +
        got[k].to_int().to_string() +
        " want " +
        want[k].to_int().to_string(),
      )
    }
    k += 1
  }
}

///|
/// A+B：固定 mode/ecl/version、mask=None（自动择优）的全矩阵端到端逐位对齐（V05 三模式×4ECL）。
let s6_matrix_cases : Array[(Array[Byte], Mode, ECL, String)] = [
  (
    c0(),
    Mode::Numeric,
    ECL::L,
    "",
  ),
  (
    c0(),
    Mode::Numeric,
    ECL::M,
    "",
  ),
  (
    c0(),
    Mode::Numeric,
    ECL::Q,
    "",
  ),
  (
    c0(),
    Mode::Numeric,
    ECL::H,
    "",
  ),
  (
    c1(),
    Mode::Alphanumeric,
    ECL::L,
    "",
  ),
  (
    c1(),
    Mode::Alphanumeric,
    ECL::M,
    "",
  ),
  (
    c1(),
    Mode::Alphanumeric,
    ECL::Q,
    "",
  ),
  (
    c1(),
    Mode::Alphanumeric,
    ECL::H,
    "",
  ),
  (
    c2(),
    Mode::Byte,
    ECL::L,
    "",
  ),
  (
    c2(),
    Mode::Byte,
    ECL::M,
    "",
  ),
  (
    c2(),
    Mode::Byte,
    ECL::Q,
    "",
  ),
  (
    c2(),
    Mode::Byte,
    ECL::H,
    "",
  ),
]

///|
/// B+C：特殊/边界用例 —— V01 最短、版本信息区 V14/V26/V32、全自动(全 None)路径。
let s6_special_cases : Array[(Array[Byte], Mode?, ECL?, Version?, String)] = [
  (
    c3(),
    Some(Mode::Numeric),
    Some(ECL::L),
    Some(Version::V01),
    "",
  ),
  (
    c4(),
    Some(Mode::Byte),
    Some(ECL::Q),
    Some(Version::V14),
    "",
  ),
  (
    c4(),
    Some(Mode::Byte),
    Some(ECL::Q),
    Some(Version::V26),
    "",
  ),
  (
    c4(),
    Some(Mode::Byte),
    Some(ECL::Q),
    Some(Version::V32),
    "",
  ),
  (
    c3(),
    Some(Mode::Numeric),
    Some(ECL::Q),
    Some(Version::V01),
    "",
  ),
  (
    c1(),
    Some(Mode::Alphanumeric),
    Some(ECL::Q),
    Some(Version::V03),
    "",
  ),
  (
    c4(),
    Some(Mode::Byte),
    Some(ECL::Q),
    Some(Version::V03),
    "",
  ),
]

///|
test "s6_three_mode_ecl_matrix_e2e" {
  let mut i = 0
  while i < s6_matrix_cases.length() {
    let (input, modev, eclv, hexs) = s6_matrix_cases[i]
    let (got, _, _, _, _) = s6_raw(
      input,
      Some(modev),
      Some(eclv),
      Some(Version::V05),
      None,
    )
    s6_assert_matrix(got, parse_hex(hexs), "s6_matrix#" + i.to_string())
    i += 1
  }
}

///|
test "s6_special_boundary_auto_paths" {
  let mut i = 0
  while i < s6_special_cases.length() {
    let (input, modev, eclv, verv, hexs) = s6_special_cases[i]
    let (got, _, _, _, _) = s6_raw(input, modev, eclv, verv, None)
    s6_assert_matrix(got, parse_hex(hexs), "s6_special#" + i.to_string())
    i += 1
  }
}

///|
/// V40-H 满容量边界（矩阵 177×177，S6 边界覆盖收口）：强制 V40 & ECL H & Byte 模式，mask=None 自动择优。
test "s6_v40h_full_capacity" {
  let (got, _, _, _, _) = s6_raw(
    c_v40h(),
    Some(Mode::Byte),
    Some(ECL::H),
    Some(Version::V40),
    None,
  )
  s6_assert_matrix(
    got,
    parse_hex(
      "",
    ),
    "s6_v40h",
  )
}
