///|
/// version.mbt —— 公共版本枚举（V01-V40）
/// 对应参考：fast_qr v0.14.0 `src/version.rs`（roadmap 批次 B2）。
/// 职责：对外版本枚举与序号（0..=39）映射。容量/分组等元数据大表放
///       `lib/internal/constants/capacity.mbt`（批次 B2 已落地，本文件不做查表）。
/// 语义：`to_int` 序号 = 版本号 - 1（V01=0 .. V40=39），与 Rust 判别值一致。

///|
/// QR 码版本（ISO/IEC 18004 版本 1..=40）。
/// 每个版本的矩阵边长 = 版本号 * 4 + 17。
pub(all) enum Version {
  V01
  V02
  V03
  V04
  V05
  V06
  V07
  V08
  V09
  V10
  V11
  V12
  V13
  V14
  V15
  V16
  V17
  V18
  V19
  V20
  V21
  V22
  V23
  V24
  V25
  V26
  V27
  V28
  V29
  V30
  V31
  V32
  V33
  V34
  V35
  V36
  V37
  V38
  V39
  V40
} derive(Eq, Debug)

///|
/// 版本序号（0..=39）：V01=0，V40=39。
pub fn Version::to_int(self : Version) -> Int {
  match self {
    V01 => 0
    V02 => 1
    V03 => 2
    V04 => 3
    V05 => 4
    V06 => 5
    V07 => 6
    V08 => 7
    V09 => 8
    V10 => 9
    V11 => 10
    V12 => 11
    V13 => 12
    V14 => 13
    V15 => 14
    V16 => 15
    V17 => 16
    V18 => 17
    V19 => 18
    V20 => 19
    V21 => 20
    V22 => 21
    V23 => 22
    V24 => 23
    V25 => 24
    V26 => 25
    V27 => 26
    V28 => 27
    V29 => 28
    V30 => 29
    V31 => 30
    V32 => 31
    V33 => 32
    V34 => 33
    V35 => 34
    V36 => 35
    V37 => 36
    V38 => 37
    V39 => 38
    V40 => 39
  }
}

///|
/// 由序号（0..=39）还原版本。越界回退到 `V40`（最大版本）。
pub fn Version::from_int(i : Int) -> Version {
  match i {
    0 => V01
    1 => V02
    2 => V03
    3 => V04
    4 => V05
    5 => V06
    6 => V07
    7 => V08
    8 => V09
    9 => V10
    10 => V11
    11 => V12
    12 => V13
    13 => V14
    14 => V15
    15 => V16
    16 => V17
    17 => V18
    18 => V19
    19 => V20
    20 => V21
    21 => V22
    22 => V23
    23 => V24
    24 => V25
    25 => V26
    26 => V27
    27 => V28
    28 => V29
    29 => V30
    30 => V31
    31 => V32
    32 => V33
    33 => V34
    34 => V35
    35 => V36
    36 => V37
    37 => V38
    38 => V39
    _ => V40
  }
}

///|
/// 矩阵边长：`版本号 * 4 + 17`（版本号 = 序号 + 1）。
pub fn Version::width(self : Version) -> Int {
  (self.to_int() + 1) * 4 + 17
}
