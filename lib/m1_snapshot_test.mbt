///|
/// m1_snapshot_test.mbt —— M1 固定参数首码快照逐位对齐（黑盒 _test.mbt）
/// 基准：fast_qr v0.14.0 `snapshot_gen` 例程固定 mode(Byte)/ecl/version/mask 生成的完整矩阵。
/// 介质：公共 `Module.byte()` = `明暗|类型<<1`，与参考快照同构；按格逐位（十六进制）比对。
/// 覆盖：V1/V5/V7/V10 × L/M/Q/H × mask 0/1/2/3/5/7（含 V7+/V10 版本信息区、mask 5/7 网格）。
///
/// 溯源元数据（T0-b）：生成器 scripts/snapshot_gen_s6.rs ｜ 参考 fast_qr commit 53e8c99（v0.14.0）
/// ｜ 生成日期 2026-09-13 ｜ 复跑校验：bash scripts/gen-goldens.sh --verify（仅覆盖常量表指纹）
/// ｜ 快照重建：见 scripts/snapshot_gen_s6.rs 头注释（拷入参考 examples 后经 stdin 喂 cases.txt）。

///|
/// 输入统一 'hi'（强制 Byte 模式；各强制版本/纠错均能容纳，编码填充至满）。
fn input_hi() -> Array[Byte] {
  let r : Array[Byte] = []
  for ch in "hi" {
    r.push(ch.to_int().to_byte())
  }
  r
}

///|
/// 十六进制字符 → 0..15。
fn hexval(ch : Char) -> Int {
  let c = ch.to_int()
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    0
  }
}

///|
/// 十六进制串 → Byte 数组（快照期望逐格值，明暗|类型<<1）。
fn parse_hex(s : String) -> Array[Byte] {
  let out : Array[Byte] = []
  let mut hi = -1
  for ch in s {
    let d = hexval(ch)
    if hi < 0 {
      hi = d
    } else {
      out.push(((hi << 4) | d).to_byte())
      hi = -1
    }
  }
  out
}

///|
/// build_fixed 并把有效区 size*size 序列化为 Byte 数组。
fn build_raw(ver : Version, eclv : ECL, maskv : Mask) -> Array[Byte] {
  let qr = match
    QRCode::build_fixed(
      input_hi(),
      Some(Mode::Byte),
      Some(eclv),
      Some(ver),
      maskv,
    ) {
    Ok(q) => q
    Err(_) => abort("build_fixed failed")
  }
  let n = qr.size()
  let out : Array[Byte] = []
  let mut i = 0
  while i < n * n {
    out.push(qr.get(i / n, i % n).byte())
    i += 1
  }
  out
}

///|
/// 遍历全部固定 mask 快照用例，逐格比对 build_fixed 与参考 hex。
test "m1_fixed_mask_snapshots" {
  let mut idx = 0
  while idx < 8 {
    let (ver, eclv, maskv, hexs) = cases[idx]
    let got = build_raw(ver, eclv, maskv)
    let want = parse_hex(hexs)
    if got.length() != want.length() {
      fail("case " + idx.to_string() + " length mismatch")
    }
    let mut k = 0
    while k < got.length() {
      if got[k] != want[k] {
        fail(
          "case " +
          idx.to_string() +
          " cell " +
          k.to_string() +
          ": got " +
          got[k].to_int().to_string() +
          " want " +
          want[k].to_int().to_string(),
        )
      }
      k += 1
    }
    idx += 1
  }
}

///|
/// 用例表：(Version, ECL, Mask, 参考快照 hex)。
let cases : Array[(Version, ECL, Mask, String)] = [
  (
    Version::V01,
    ECL::L,
    Mask::Checkerboard,
    "",
  ),
  (
    Version::V01,
    ECL::H,
    Mask::HorizontalLines,
    "",
  ),
  (
    Version::V05,
    ECL::M,
    Mask::VerticalLines,
    "",
  ),
  (
    Version::V05,
    ECL::Q,
    Mask::DiagonalLines,
    "",
  ),
  (
    Version::V07,
    ECL::H,
    Mask::Fields,
    "",
  ),
  (
    Version::V10,
    ECL::Q,
    Mask::Meadow,
    "",
  ),
  (
    Version::V01,
    ECL::Q,
    Mask::Checkerboard,
    "",
  ),
  (
    Version::V05,
    ECL::L,
    Mask::Fields,
    "",
  ),
]

///|
/// ===== S5 自动择优快照（黑盒追加）=====
/// 基准：fast_qr v0.14.0 `snapshot_gen_auto` 固定 mode/ecl/version、mask=None（自动择优）的最优掩码+矩阵。
///

///|
fn input_hello() -> Array[Byte] {
  let r : Array[Byte] = []
  for ch in "Hello World!" {
    r.push(ch.to_int().to_byte())
  }
  r
}

///|
fn input_url() -> Array[Byte] {
  let r : Array[Byte] = []
  for ch in "https://example.com/" {
    r.push(ch.to_int().to_byte())
  }
  r
}

///|
fn build_auto(
  input : Array[Byte],
  ver : Version,
  eclv : ECL,
  modev : Mode,
) -> (Array[Byte], Int) {
  let qr = match
    QRCode::build(input, Some(modev), Some(eclv), Some(ver), None) {
    Ok(q) => q
    Err(_) => abort("build auto failed")
  }
  let n = qr.size()
  let out : Array[Byte] = []
  let mut i = 0
  while i < n * n {
    out.push(qr.get(i / n, i % n).byte())
    i += 1
  }
  let m = match qr.mask() {
    Some(x) => x.to_int()
    None => abort("mask none")
  }
  (out, m)
}

///|
test "s5_auto_mask_snapshots" {
  let mut idx = 0
  while idx < auto_cases.length() {
    let (input, ver, eclv, modev, mask_want, hexs) = auto_cases[idx]
    let (got, got_mask) = build_auto(input, ver, eclv, modev)
    if got_mask != mask_want {
      fail(
        "case " +
        idx.to_string() +
        " mask got " +
        got_mask.to_string() +
        " want " +
        mask_want.to_string(),
      )
    }
    let want = parse_hex(hexs)
    if got.length() != want.length() {
      fail("case " + idx.to_string() + " length mismatch")
    }
    let mut k = 0
    while k < got.length() {
      if got[k] != want[k] {
        fail(
          "case " +
          idx.to_string() +
          " cell " +
          k.to_string() +
          ": got " +
          got[k].to_int().to_string() +
          " want " +
          want[k].to_int().to_string(),
        )
      }
      k += 1
    }
    idx += 1
  }
}

///|
let auto_cases : Array[(Array[Byte], Version, ECL, Mode, Int, String)] = [
  (
    input_hi(),
    Version::V01,
    ECL::L,
    Mode::Byte,
    6,
    "",
  ),
  (
    input_hi(),
    Version::V01,
    ECL::H,
    Mode::Byte,
    0,
    "",
  ),
  (
    input_hi(),
    Version::V05,
    ECL::M,
    Mode::Byte,
    4,
    "",
  ),
  (
    input_hi(),
    Version::V05,
    ECL::Q,
    Mode::Byte,
    4,
    "",
  ),
  (
    input_hi(),
    Version::V07,
    ECL::H,
    Mode::Byte,
    0,
    "",
  ),
  (
    input_hi(),
    Version::V10,
    ECL::Q,
    Mode::Byte,
    2,
    "",
  ),
  (
    input_hi(),
    Version::V01,
    ECL::Q,
    Mode::Byte,
    3,
    "",
  ),
  (
    input_hi(),
    Version::V05,
    ECL::L,
    Mode::Byte,
    1,
    "",
  ),
  (
    input_hello(),
    Version::V02,
    ECL::M,
    Mode::Byte,
    5,
    "",
  ),
  (
    input_url(),
    Version::V04,
    ECL::Q,
    Mode::Byte,
    2,
    "",
  ),
]
